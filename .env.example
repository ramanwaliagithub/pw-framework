# Copy to .env and fill in real values. Never commit .env itself.

TEST_ENV=qa

# App auth (UI)
APP_USERNAME=standard_user
APP_PASSWORD=secret_sauce

# API auth
API_TOKEN=replace_me
API_CLIENT_ID=replace_me
API_CLIENT_SECRET=replace_me

# Database (overrides config/environments.yaml if set)
DB_USER=replace_me
DB_PASSWORD=replace_me

# Notifications
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Vault (optional, conceptual integration point)
VAULT_ADDR=
VAULT_TOKEN=
